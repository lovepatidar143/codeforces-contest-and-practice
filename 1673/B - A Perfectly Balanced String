#include <bits/stdc++.h>
using namespace std;
 
using ll = long long;
using vi = vector<int>;
using vll = vector<ll>;
using pii = pair<int,int>;
 
#define all(x) (x).begin(), (x).end()
#define endl '
'
 
void solve() {
    string s ; 
    cin >> s ; 
    vector<int> hash(26 , 0) ; 
    int n = s.size() ; 
    int i = 0 ; 
    string t = "" ; 
    while(i < n && hash[s[i] -'a'] == 0){
        t += s[i] ; 
        hash[s[i] -'a']++;
        i++;
    }
    if(i == n) {
        cout << "YES" << endl ; 
        return ; 
    }
    int m = t.size() ; 
    for(int a = i ; a < n ; a+=m){
        for(int k = a ; k< a+m ;k++ ){
            if( k < n && s[k] != t[k -a ]) {
                cout << "NO" << endl ; 
                return ; 
            }
        }
    }
    cout << "YES" << endl ; 
    return ; 
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin >> t;
 
    while (t--)
        solve();
 
    return 0;
}